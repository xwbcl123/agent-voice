def cmd_audition(target: str, style_id: str | None = None, corpus_key: str | None = None, no_play: bool = False):
    """Run standard audition test corpus against profile(s) with optional style."""
    voices_dir = get_voices_dir()
    profiles = []
    if target == "--all" or target == "all":
        for item in sorted(voices_dir.iterdir()):
            if item.is_dir() and validate_voice_id(item.name):
                p = get_voice_profile(item.name)
                if p:
                    profiles.append(p)
    else:
        p = get_voice_profile(target)
        if not p:
            print(f"❌ 错误: 未找到音色 profile '{target}'")
            return 1
        profiles.append(p)

    items = AUDITION_CORPUS if not corpus_key else {corpus_key: AUDITION_CORPUS.get(corpus_key, "测试文本")}
    out_base = Path("/tmp/agent-voice-auditions")
    out_base.mkdir(parents=True, exist_ok=True)

    style_prof = get_style_profile(style_id) if style_id else None

    for p in profiles:
        vid = p["id"]
        prof_out = out_base / vid
        prof_out.mkdir(parents=True, exist_ok=True)
        style_desc = f" (Style: {style_id})" if style_id else ""
        print(f"\n🎧 正在为音色 [{vid}]{style_desc} 执行 Audition 评测...")

        for key, text in items.items():
            out_wav = prof_out / f"{key}.wav"
            print(f"   -> [{key}] \"{text}\"")
            lang = "chinese" if re.search(r"[\u4e00-\u9fff]", text) else "english"
            cmd = [
                str(SPEECH_BIN), "speak", text,
                "--engine", "cosyvoice",
                "--cosyvoice-variant", COSY_VARIANT,
                "--voice-sample", str(p["wav"]),
                "--cosy-reference-transcript", p["transcript"],
                "--language", lang,
                "-o", str(out_wav)
            ]
            if style_prof:
                instruct = select_instruction_prompt(style_prof, text)
                if instruct:
                    cmd.extend(["--cosy-instruct", instruct])

            try:
                res = subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=16)
                if res.returncode == 0 and out_wav.is_file():
                    print(f"      ✅ 生成成功: {out_wav.name}")
                    if not no_play:
                        subprocess.run(["/usr/bin/afplay", str(out_wav)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                else:
                    print(f"      ❌ 合成失败 (code {res.returncode})")
            except Exception as exc:
                print(f"      ❌ 异常: {exc}")
    return 0


def cmd_migrate(to_v4: bool = False):
    """Migrate legacy voice assets and upgrade config.yml to v4 structure."""
    import shutil
    legacy_wav = USER_SHARE_DIR / "reference.wav"
    legacy_txt = USER_SHARE_DIR / "reference.txt"
    dest_default = USER_SHARE_DIR / "voices/default"

    if legacy_wav.is_file() and legacy_txt.is_file():
        dest_default.mkdir(parents=True, exist_ok=True)
        target_wav = dest_default / "reference.wav"
        target_txt = dest_default / "reference.txt"
        target_yml = dest_default / "voice.yml"

        if not target_wav.is_file():
            shutil.copy2(legacy_wav, target_wav)
            print(f"✅ 复制 reference.wav -> {target_wav}")
        if not target_txt.is_file():
            shutil.copy2(legacy_txt, target_txt)
            print(f"✅ 复制 reference.txt -> {target_txt}")
        if not target_yml.is_file():
            default_meta = {
                "schema_version": 1,
                "id": "default",
                "name": "Default Voice",
                "version": "1.0.0",
                "description": "Baseline high-fidelity voice profile migrated from v2.1.0.",
                "language": {"primary": "zh", "supported": ["zh", "en", "mixed"]},
                "style": {"energy": "medium", "warmth": "medium", "authority": "medium", "pace": "medium", "fatigue": "low"},
                "reference": {"wav": "reference.wav", "transcript": "reference.txt"},
                "source": {"type": "consented_person", "usage": "personal_experiment", "redistributable": False},
                "use_cases": ["default", "coding", "completion"],
                "tags": ["baseline", "migrated", "clear"],
                "quality": {"status": "approved", "naturalness": 5, "intelligibility": 5, "low_fatigue": 5}
            }
            save_yaml_file(target_yml, default_meta)
            print(f"✅ 创建默认元数据 -> {target_yml}")

    # v4 migration: deploy styles.yml and upgrade config.yml
    USER_STYLES_FILE.parent.mkdir(parents=True, exist_ok=True)
    if not USER_STYLES_FILE.is_file() and LOCAL_STYLES_FILE.is_file():
        shutil.copy2(LOCAL_STYLES_FILE, USER_STYLES_FILE)
        print(f"✅ 部署默认风格注册表 -> {USER_STYLES_FILE}")

    if USER_CONFIG_FILE.is_file():
        bak_file = USER_CONFIG_FILE.parent / f"config.yml.v3.bak-{int(time.time())}"
        shutil.copy2(USER_CONFIG_FILE, bak_file)
        print(f"✅ 备份现有配置 -> {bak_file}")

        cfg = load_yaml_file(USER_CONFIG_FILE)
        if isinstance(cfg, dict):
            cfg.setdefault("default_style", "neutral")
            routing = cfg.get("routing", {})
            new_routing = {}
            for k, v in routing.items():
                if isinstance(v, str):
                    new_routing[k] = {"voice": v, "style": "neutral"}
                else:
                    new_routing[k] = v
            cfg["routing"] = new_routing
            save_yaml_file(USER_CONFIG_FILE, cfg)
            print(f"✅ 升级配置至 v4.0.0 (支持 Voice × Style 对象路由) -> {USER_CONFIG_FILE}")

    print("🎉 迁移与升级流程执行完成。")
    return 0


# ==============================================================================
# CLI Entrypoint & Argument Dispatcher
# ==============================================================================
def main():
    if len(sys.argv) < 2:
        print("用法:")
        print("  agent-voice \"<文本>\"                          # 基础播放 (默认音色与风格)")
        print("  agent-voice --voice <id> \"<文本>\"           # 指定音色播放")
        print("  agent-voice --style <id> \"<文本>\"           # 指定预置风格播报 (如 warm/serious/urgent)")
        print("  agent-voice --instruct \"<prompt>\" \"<文本>\" # 专家模式：自定义指令控制语调韵律")
        print("  agent-voice --speed 1.05 --gain 1 \"<文本>\"  # 自定义播放语速与音量增益 (dB)")
        print("  agent-voice --dry-run --style warm \"<文本>\" # 仿真解析 Voice × Style，不发音")
        print("  agent-voice --event <event> \"<文本>\"         # 按事件类型自动路由音色与风格")
        print("  agent-voice voices                           # 列出所有已注册音色")
        print("  agent-voice voice show <id>                  # 查看指定音色详情")
        print("  agent-voice voice validate <id|--all>        # 校验音色声学资产与元数据")
        print("  agent-voice voice normalize <id>             # 标准化音频 (24kHz Mono WAV)")
        print("  agent-voice styles                           # 列出所有已注册风格 Profile")
        print("  agent-voice style show <id>                  # 查看指定风格详情与指令模板")
        print("  agent-voice doctor                           # 本地语音运行时能力探针")
        print("  agent-voice benchmark                        # 运行风格耗时与 RTF 性能评测")
        print("  agent-voice audition <id|--all>              # 运行标准测试语料生成")
        print("  agent-voice migrate [--to 4]                 # 升级配置并部署 styles.yml")
        sys.exit(0)

    first_arg = sys.argv[1]

    if first_arg in ("voices", "list"):
        sys.exit(cmd_voices_list())

    if first_arg == "styles":
        sys.exit(cmd_styles_list())

    if first_arg == "style":
        if len(sys.argv) < 3:
            print("用法: agent-voice style show <id>")
            sys.exit(1)
        sub = sys.argv[2]
        if sub == "show" and len(sys.argv) >= 4:
            sys.exit(cmd_style_show(sys.argv[3]))
        else:
            print(f"未知 style 子命令: {sub}")
            sys.exit(1)

    if first_arg == "doctor":
        sys.exit(cmd_doctor())

    if first_arg == "benchmark":
        p = argparse.ArgumentParser(prog="agent-voice benchmark")
        p.add_argument("--voice", default=None)
        p.add_argument("--styles", default=None)
        p.add_argument("--runs", type=int, default=1)
        p.add_argument("--text", default=None)
        b_args = p.parse_args(sys.argv[2:])
        sys.exit(cmd_benchmark(voice_id=b_args.voice, styles_str=b_args.styles, runs=b_args.runs, text=b_args.text))

    if first_arg == "voice":
        if len(sys.argv) < 3:
            print("用法: agent-voice voice [show|validate|normalize] <id>")
            sys.exit(1)
        sub = sys.argv[2]
        if sub == "show" and len(sys.argv) >= 4:
            sys.exit(cmd_voice_show(sys.argv[3]))
        elif sub == "validate" and len(sys.argv) >= 4:
            sys.exit(cmd_voice_validate(sys.argv[3]))
        elif sub == "normalize" and len(sys.argv) >= 4:
            sys.exit(cmd_voice_normalize(sys.argv[3]))
        else:
            print(f"未知 voice 子命令: {sub}")
            sys.exit(1)

    if first_arg == "audition":
        if len(sys.argv) < 3:
            print("用法: agent-voice audition <id|--all> [--style <id>] [--corpus <corpus_key>] [--no-play]")
            sys.exit(1)
        target = sys.argv[2]
        corpus_key = None
        style_key = None
        no_play = "--no-play" in sys.argv
        if "--corpus" in sys.argv:
            idx = sys.argv.index("--corpus")
            if idx + 1 < len(sys.argv):
                corpus_key = sys.argv[idx + 1]
        if "--style" in sys.argv:
            idx = sys.argv.index("--style")
            if idx + 1 < len(sys.argv):
                style_key = sys.argv[idx + 1]
        sys.exit(cmd_audition(target, style_id=style_key, corpus_key=corpus_key, no_play=no_play))

    if first_arg == "migrate":
        to_v4 = "--to" in sys.argv or "4" in sys.argv
        sys.exit(cmd_migrate(to_v4=to_v4))

    # Speech synthesis flags & positional dispatch
    parser = argparse.ArgumentParser(prog="agent-voice", add_help=False)
    parser.add_argument("-v", "--voice", dest="voice", default=None, help="Explicit voice ID")
    parser.add_argument("-e", "--event", dest="event", default=None, help="Event category for routing")
    parser.add_argument("-s", "--style", "--instruct-profile", dest="style", default=None, help="Explicit style profile ID")
    parser.add_argument("--instruct", dest="instruct", default=None, help="Raw instruction prompt (expert mode)")
    parser.add_argument("--speed", dest="speed", type=float, default=None, help="Playback speed multiplier (0.75-1.25)")
    parser.add_argument("--gain", dest="gain", type=float, default=None, help="Playback gain in dB (-12 to +3)")
    parser.add_argument("--dry-run", dest="dry_run", action="store_true", help="Print resolved parameters and exit without synthesis")
    parser.add_argument("--require-instruct", dest="require_instruct", action="store_true", help="Fail if instruct2 is unsupported")
    parser.add_argument("text", nargs="*", help="Text to speak")

    args, remaining = parser.parse_known_args()
    all_text = " ".join(args.text + remaining).strip()

    if not all_text:
        sys.exit(0)

    exit_code = speak(
        text=all_text,
        voice_id=args.voice,
        style_id=args.style,
        raw_instruct=args.instruct,
        speed=args.speed,
        gain=args.gain,
        event=args.event,
        require_instruct=args.require_instruct,
        dry_run=args.dry_run,
    )
    sys.exit(exit_code)


if __name__ == "__main__":
    main()
