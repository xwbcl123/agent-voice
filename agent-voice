def cmd_voices_list():
    """List all registered voice profiles."""
    voices_dir = get_voices_dir()
    if not voices_dir.is_dir():
        print("未发现 voices 目录。请先运行 'agent-voice migrate' 或 './setup.sh'。")
        return 0

    profiles = []
    for item in sorted(voices_dir.iterdir()):
        if item.is_dir() and validate_voice_id(item.name):
            prof = get_voice_profile(item.name)
            if prof:
                profiles.append(prof)

    if not profiles:
        print("未检测到已注册的音色配置文件。")
        return 0

    cfg = get_config()
    def_voice = cfg.get("default_voice", "default")

    print(f"{'ID':<18} {'STATUS':<12} {'STYLE':<32} {'TAGS'}")
    print("-" * 75)
    for p in profiles:
        meta = p["meta"]
        vid = p["id"]
        if vid == def_voice:
            vid += " *"
        status = p["status"]
        style_dict = meta.get("style", {})
        style_summary = f"{style_dict.get('energy', '-')}/{style_dict.get('warmth', '-')}/{style_dict.get('fatigue', '-')}"
        tags = ", ".join(meta.get("tags", [])) or "-"
        print(f"{vid:<18} {status:<12} {style_summary:<32} {tags}")
    print("\n* 标记为当前默认音色 (default_voice)")
    return 0


def cmd_voice_show(voice_id: str):
    """Show detailed information for a voice profile."""
    prof = get_voice_profile(voice_id)
    if not prof:
        print(f"❌ 错误: 未找到音色 profile '{voice_id}'")
        return 1

    meta = prof["meta"]
    print(f"=== Voice Profile: {prof['id']} ===")
    print(f"Name:        {meta.get('name', prof['id'])}")
    print(f"Version:     {meta.get('version', '1.0.0')}")
    print(f"Status:      {prof['status']}")
    print(f"Description: {meta.get('description', '').strip()}")
    print(f"Directory:   {prof['dir']}")
    print(f"Audio File:  {prof['wav']} ({'存在' if prof['wav'].is_file() else '缺失'})")
    if prof['wav'].is_file():
        try:
            with wave.open(str(prof['wav']), "rb") as w:
                dur = round(w.getnframes() / float(w.getframerate()), 2)
                print(f"             {w.getframerate()}Hz, {w.getnchannels()}声道, 耗时 {dur}s")
        except Exception:
            pass
    print(f"Transcript:  {prof['txt']} ({'存在' if prof['txt'].is_file() else '缺失'})")
    print(f"Text Content: \"{prof['transcript']}\"")
    print(f"Source:      {meta.get('source', {}).get('type', 'unknown')}")
    print(f"Use Cases:   {', '.join(meta.get('use_cases', []))}")
    print(f"Tags:        {', '.join(meta.get('tags', []))}")
    return 0


def validate_single_profile(prof: dict) -> tuple[int, list[str]]:
    """Validate a single voice profile against acoustic and metadata rules."""
    issues = []
    has_error = False
    has_warn = False

    if not prof["wav"].is_file():
        issues.append("❌ 错误: reference.wav 文件不存在")
        has_error = True
    else:
        try:
            with wave.open(str(prof["wav"]), "rb") as w:
                channels = w.getnchannels()
                rate = w.getframerate()
                dur = w.getnframes() / float(rate)

                if dur < 3.0:
                    issues.append(f"⚠️ 警告: 音频时长 {round(dur, 2)}s 过短 (< 3.0s)")
                    has_warn = True
                elif dur > 12.0:
                    issues.append(f"⚠️ 警告: 音频时长 {round(dur, 2)}s 过长 (> 12.0s)")
                    has_warn = True

                if channels != 1:
                    issues.append(f"⚠️ 警告: 音频为 {channels} 声道，推荐单声道 Mono")
                    has_warn = True

                if rate != 24000:
                    issues.append(f"⚠️ 提示: 采样率为 {rate}Hz，推荐标准 24000Hz")
                    has_warn = True
        except Exception as exc:
            issues.append(f"❌ 错误: 无法解析 WAV 头部: {exc}")
            has_error = True

    if not prof["txt"].is_file():
        issues.append("❌ 错误: reference.txt 文件不存在")
        has_error = True
    elif not prof["transcript"]:
        issues.append("❌ 错误: reference.txt 转录文本为空")
        has_error = True

    meta = prof["meta"]
    if not meta:
        issues.append("⚠️ 警告: 未找到有效的 voice.yml 元数据")
        has_warn = True

    if has_error:
        return 2, issues
    if has_warn:
        return 1, issues
    return 0, ["✅ 所有硬性规范与声学参数校验通过"]


def cmd_voice_validate(target: str):
    """Validate voice profile(s)."""
    voices_dir = get_voices_dir()
    profiles_to_check = []

    if target == "--all" or target == "all":
        for item in sorted(voices_dir.iterdir()):
            if item.is_dir() and validate_voice_id(item.name):
                p = get_voice_profile(item.name)
                if p:
                    profiles_to_check.append(p)
    else:
        p = get_voice_profile(target)
        if not p:
            print(f"❌ 错误: 未找到音色 profile '{target}'")
            return 2
        profiles_to_check.append(p)

    max_exit = 0
    for p in profiles_to_check:
        code, issues = validate_single_profile(p)
        max_exit = max(max_exit, code)
        icon = "✅" if code == 0 else ("⚠️" if code == 1 else "❌")
        print(f"\n{icon} [{p['id']}] (Status: {code})")
        for issue in issues:
            print(f"   {issue}")

    return max_exit


def cmd_voice_normalize(voice_id: str):
    """Normalize reference audio using ffmpeg to 24kHz mono 16-bit PCM."""
    prof = get_voice_profile(voice_id)
    if not prof:
        print(f"❌ 错误: 未找到音色 profile '{voice_id}'")
        return 1

    wav_path = prof["wav"]
    if not wav_path.is_file():
        print(f"❌ 错误: 音频文件不存在: {wav_path}")
        return 1

    temp_out = wav_path.parent / f"normalized-{int(time.time())}.wav"
    cmd = [
        "ffmpeg", "-y", "-i", str(wav_path),
        "-ar", "24000", "-ac", "1", "-c:a", "pcm_s16le",
        str(temp_out)
    ]
    try:
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True)
        if temp_out.is_file() and temp_out.stat().st_size > 44:
            temp_out.replace(wav_path)
            print(f"✅ 音频标准化成功: {wav_path} (24000Hz, Mono, 16-bit PCM)")
            return 0
    except Exception as exc:
        print(f"❌ 标准化失败: {exc}")
        if temp_out.is_file():
            temp_out.unlink()
        return 1
    return 1


