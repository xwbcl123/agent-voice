# ==============================================================================
# Utility & Serialization Functions
# ==============================================================================
def sanitize_text(text: str, max_chars: int = 300) -> str:
    """Strip unprintable characters and bound length safely."""
    cleaned = "".join(ch for ch in text if ch.isprintable() or ch in " \t\n")
    cleaned = cleaned.strip()
    return cleaned[:max_chars]


def load_yaml_file(path: Path) -> dict:
    """Load YAML file with safe fallback parser if PyYAML is unavailable."""
    if not path.is_file():
        return {}
    raw = path.read_text(encoding="utf-8")
    if HAS_YAML:
        try:
            return yaml.safe_load(raw) or {}
        except Exception:
            return {}
    # Minimal fallback parser for simple key-value YAML
    data = {}
    for line in raw.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if ":" in line:
            k, v = line.split(":", 1)
            data[k.strip()] = v.strip().strip("'\"")
    return data


def save_yaml_file(path: Path, data: dict) -> None:
    """Save dictionary to YAML file."""
    path.parent.mkdir(parents=True, exist_ok=True)
    if HAS_YAML:
        with open(path, "w", encoding="utf-8") as f:
            yaml.dump(data, f, allow_unicode=True, sort_keys=False)
    else:
        with open(path, "w", encoding="utf-8") as f:
            f.write(json.dumps(data, ensure_ascii=False, indent=2))


def get_config() -> dict:
    """Load global config merged with defaults."""
    cfg = dict(DEFAULT_CONFIG)
    if USER_CONFIG_FILE.is_file():
        user_cfg = load_yaml_file(USER_CONFIG_FILE)
        if isinstance(user_cfg, dict):
            if "default_voice" in user_cfg:
                cfg["default_voice"] = user_cfg["default_voice"]
            if "default_style" in user_cfg:
                cfg["default_style"] = user_cfg["default_style"]
            if "routing" in user_cfg and isinstance(user_cfg["routing"], dict):
                cfg["routing"].update(user_cfg["routing"])
            if "behavior" in user_cfg and isinstance(user_cfg["behavior"], dict):
                cfg["behavior"].update(user_cfg["behavior"])
    return cfg


# ==============================================================================
# Voice & Style Registry Management
# ==============================================================================
def get_voices_dir() -> Path:
    """Locate voices directory: checks ~/.local/share/agent-voice/voices, then repo path."""
    user_voices = USER_SHARE_DIR / "voices"
    if user_voices.is_dir():
        return user_voices
    local_voices = Path(__file__).resolve().parent / "voices"
    if local_voices.is_dir():
        return local_voices
    return user_voices


def get_styles_file() -> Path:
    """Locate styles.yml file: checks user config, then local repo."""
    if USER_STYLES_FILE.is_file():
        return USER_STYLES_FILE
    if LOCAL_STYLES_FILE.is_file():
        return LOCAL_STYLES_FILE
    return USER_STYLES_FILE


def load_styles() -> dict:
    """Load style profile definitions from styles.yml."""
    f = get_styles_file()
    data = load_yaml_file(f)
    if isinstance(data, dict) and "profiles" in data and isinstance(data["profiles"], dict):
        return data["profiles"]
    return {}


def validate_voice_id(voice_id: str) -> bool:
    """Check that voice ID is safe and conforms to regex."""
    if not voice_id or "/" in voice_id or "\\" in voice_id or ".." in voice_id:
        return False
    return bool(VOICE_ID_REGEX.match(voice_id))


def validate_style_id(style_id: str) -> bool:
    """Check that style ID is safe and conforms to regex."""
    if not style_id or "/" in style_id or "\\" in style_id or ".." in style_id:
        return False
    return bool(STYLE_ID_REGEX.match(style_id))


def get_style_profile(style_id: str) -> dict | None:
    """Retrieve style profile dictionary by ID."""
    if not validate_style_id(style_id):
        return None
    styles = load_styles()
    return styles.get(style_id)


def select_instruction_prompt(style_prof: dict, text: str) -> str:
    """Select appropriate Chinese or English instruction prompt based on target text."""
    has_cjk = bool(re.search(r"[\u4e00-\u9fff]", text))
    zh = style_prof.get("instruction_zh", "").strip()
    en = style_prof.get("instruction_en", "").strip()
    if has_cjk and zh:
        return zh
    if not has_cjk and en:
        return en
    return zh or en


def get_voice_profile(voice_id: str) -> dict | None:
    """Retrieve voice profile directory, metadata, wav, and transcript."""
    if not validate_voice_id(voice_id):
        return None

    voices_dir = get_voices_dir()
    profile_dir = voices_dir / voice_id
    if not profile_dir.is_dir():
        return None

    meta_file = profile_dir / "voice.yml"
    meta = load_yaml_file(meta_file) if meta_file.is_file() else {}

    wav_path = profile_dir / meta.get("reference", {}).get("wav", "reference.wav")
    txt_path = profile_dir / meta.get("reference", {}).get("transcript", "reference.txt")

    if not wav_path.is_file():
        wav_path = profile_dir / "reference.wav"
    if not txt_path.is_file():
        txt_path = profile_dir / "reference.txt"

    transcript = txt_path.read_text(encoding="utf-8").strip() if txt_path.is_file() else ""

    return {
        "id": voice_id,
        "dir": profile_dir,
        "meta": meta,
        "wav": wav_path,
        "txt": txt_path,
        "transcript": transcript,
        "status": meta.get("quality", {}).get("status", "unknown"),
    }


# ==============================================================================
# Runtime Capability Probe (Doctor)
# ==============================================================================
def probe_runtime_capabilities() -> dict:
    """Inspect local binary and engine capabilities (speech, CosyVoice, instruct2, afplay)."""
    speech_ok = SPEECH_BIN.is_file() and os.access(SPEECH_BIN, os.X_OK)
    cosy_ok = False
    instruct_ok = False
    clone_ok = False

    if speech_ok:
        try:
            res = subprocess.run(
                [str(SPEECH_BIN), "speak", "--help"],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                timeout=5
            )
            help_text = res.stdout + res.stderr
            cosy_ok = "--engine" in help_text and "cosyvoice" in help_text
            instruct_ok = "--cosy-instruct" in help_text
            clone_ok = "--voice-sample" in help_text and "--cosy-reference-transcript" in help_text
        except Exception:
            pass

    afplay_bin = Path("/usr/bin/afplay")
    afplay_ok = afplay_bin.is_file() and os.access(afplay_bin, os.X_OK)
    styles_file = get_styles_file()
    styles_ok = styles_file.is_file()

    return {
        "speech_cli": speech_ok,
        "cosyvoice": cosy_ok,
        "cloning": clone_ok,
        "instruct2": instruct_ok,
        "speed_control": afplay_ok,
        "gain_control": afplay_ok,
        "styles_registry": styles_ok,
    }


# ==============================================================================
# Voice × Style Orthogonal Resolver
# ==============================================================================
def resolve_voice_and_style(
    text: str,
    requested_voice: str | None = None,
    requested_style: str | None = None,
    raw_instruct: str | None = None,
    requested_speed: float | None = None,
    requested_gain: float | None = None,
    event: str | None = None,
    require_instruct: bool = False,
) -> dict:
    """Resolve Voice Profile and Delivery Style independently with precedence, fallback, and validation."""
    cfg = get_config()
    default_voice_id = cfg.get("default_voice", "default")
    default_style_id = cfg.get("default_style", "neutral")

    # 1. Parse Event Route (Backward-compatible scalar string or v4 object)
    event_voice = None
    event_style = None
    if event:
        routing = cfg.get("routing", {})
        route = routing.get(event, routing.get("default"))
        if isinstance(route, str):
            event_voice = route
            event_style = default_style_id
        elif isinstance(route, dict):
            event_voice = route.get("voice", default_voice_id)
            event_style = route.get("style", default_style_id)

    # 2. Voice resolution
    target_voice_id = requested_voice or event_voice or default_voice_id
    voice_profile = None
    if target_voice_id and validate_voice_id(target_voice_id):
        voice_profile = get_voice_profile(target_voice_id)
    if not voice_profile:
        if default_voice_id and validate_voice_id(default_voice_id):
            voice_profile = get_voice_profile(default_voice_id)

    if not voice_profile:
        legacy_wav = USER_SHARE_DIR / "reference.wav"
        legacy_txt = USER_SHARE_DIR / "reference.txt"
        if legacy_wav.is_file() and legacy_txt.is_file():
            txt_content = legacy_txt.read_text(encoding="utf-8").strip()
            if txt_content:
                voice_profile = {
                    "id": "legacy-default",
                    "dir": USER_SHARE_DIR,
                    "meta": {"id": "legacy-default", "name": "Legacy Default"},
                    "wav": legacy_wav,
                    "txt": legacy_txt,
                    "transcript": txt_content,
                    "status": "approved",
                }

    final_voice_id = voice_profile["id"] if voice_profile else target_voice_id

    # 3. Voice profile delivery metadata & blocked styles
    delivery_meta = voice_profile.get("meta", {}).get("delivery", {}) if voice_profile else {}
    voice_def_style = delivery_meta.get("default_style")
    blocked_styles = delivery_meta.get("blocked_styles", [])

    # 4. Style resolution
    fallback_reason = "none"
    instruction_prompt = None
    resolved_style_id = None
    style_speed = 1.00
    style_gain = 0.0

    if raw_instruct:
        resolved_style_id = "raw_instruct"
        instruction_prompt = sanitize_text(raw_instruct, max_chars=MAX_INSTRUCTION_CHARS)
        style_speed = 1.00
        style_gain = 0.0
    else:
        candidate_style = requested_style or event_style or voice_def_style or default_style_id
        if candidate_style in blocked_styles:
            fallback_reason = f"blocked_by_voice:{final_voice_id}"
            resolved_style_id = voice_def_style or default_style_id
        else:
            resolved_style_id = candidate_style

        style_prof = get_style_profile(resolved_style_id)
        if not style_prof:
            resolved_style_id = "neutral"
            style_prof = get_style_profile("neutral") or {}

        instruction_prompt = select_instruction_prompt(style_prof, text)
        style_speed = float(style_prof.get("speed", 1.00))
        style_gain = float(style_prof.get("gain_db", 0.0))

    # 5. Speed and Gain resolution
    speed = requested_speed if requested_speed is not None else style_speed
    speed = max(MIN_SPEED, min(MAX_SPEED, float(speed)))
    speed = round(speed, 2)

    gain = requested_gain if requested_gain is not None else style_gain
    gain = max(MIN_GAIN_DB, min(MAX_GAIN_DB, float(gain)))
    gain = round(gain, 1)

    # 6. Instruction language
    instruction_lang = "zh" if re.search(r"[\u4e00-\u9fff]", text) else "en"

    # 7. Runtime probe & capability check
    caps = probe_runtime_capabilities()
    runtime_mode = "instruct2" if (instruction_prompt and caps["instruct2"]) else "zero-shot"

    if instruction_prompt and not caps["instruct2"]:
        if require_instruct:
            raise RuntimeError("Runtime does not support instruct2 and --require-instruct was requested.")
        fallback_reason = "instruct_unsupported"
        instruction_prompt = None

    return {
        "voice": final_voice_id,
        "voice_profile": voice_profile,
        "style": resolved_style_id,
        "instruction": instruction_prompt,
        "instruction_language": instruction_lang,
        "speed": speed,
        "gain_db": gain,
        "runtime_mode": runtime_mode,
        "fallback": fallback_reason,
    }


def resolve_voice_for_event(event: str | None, requested_voice: str | None) -> dict | None:
    """Backward-compatible helper for v3 callers and tests."""
    res = resolve_voice_and_style(text="", requested_voice=requested_voice, event=event)
    return res.get("voice_profile")


# ==============================================================================
# Speech Synthesis & Concurrency Core
# ==============================================================================
def speak(
    text: str,
    voice_id: str | None = None,
    style_id: str | None = None,
    raw_instruct: str | None = None,
    speed: float | None = None,
    gain: float | None = None,
    event: str | None = None,
    require_instruct: bool = False,
    dry_run: bool = False,
) -> int:
    """Execute speech synthesis with flock concurrency, instruct2 delivery, and rate/volume playback."""
    clean_text = sanitize_text(text)
    if not clean_text:
        return 0

    try:
        res = resolve_voice_and_style(
            text=clean_text,
            requested_voice=voice_id,
            requested_style=style_id,
            raw_instruct=raw_instruct,
            requested_speed=speed,
            requested_gain=gain,
            event=event,
            require_instruct=require_instruct,
        )
    except RuntimeError as exc:
        print(f"❌ 运行时错误: {exc}", file=sys.stderr)
        return 2

    # Handle --dry-run
    if dry_run:
        print(f"voice: {res['voice']}")
        print(f"style: {res['style']}")
        print(f"instruction_language: {res['instruction_language']}")
        print(f"speed: {res['speed']:.2f}")
        print(f"gain_db: {res['gain_db']:+.1f}")
        print(f"runtime_mode: {res['runtime_mode']}")
        print(f"fallback: {res['fallback']}")
        return 0

    profile = res.get("voice_profile")
    if not profile or not profile["wav"].is_file() or not profile["transcript"]:
        return 0

    CACHE_DIR.mkdir(parents=True, exist_ok=True)

    # 1. Non-blocking exclusive flock
    lock_fd = open(LOCK_FILE, "w")
    try:
        fcntl.flock(lock_fd.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except (BlockingIOError, OSError):
        # Busy drop policy
        return 0

    temp_wav = CACHE_DIR / f"notify-{os.getpid()}-{int(time.time()*1000)}.wav"
    cur_child: subprocess.Popen | None = None

    def terminate_child():
        nonlocal cur_child
        if cur_child is not None and cur_child.poll() is None:
            try:
                cur_child.kill()
                cur_child.wait(timeout=2)
            except Exception:
                pass
            finally:
                cur_child = None

    def handle_signal(sig, frame):
        terminate_child()
        if temp_wav.is_file():
            try:
                temp_wav.unlink()
            except Exception:
                pass
        sys.exit(0)

    for s in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
        signal.signal(s, handle_signal)

    try:
        lang = "chinese" if re.search(r"[\u4e00-\u9fff]", clean_text) else "english"
        speak_cmd = [
            str(SPEECH_BIN), "speak", clean_text,
            "--engine", "cosyvoice",
            "--cosyvoice-variant", COSY_VARIANT,
            "--voice-sample", str(profile["wav"]),
            "--cosy-reference-transcript", profile["transcript"],
            "--language", lang,
            "-o", str(temp_wav)
        ]

        if res["runtime_mode"] == "instruct2" and res["instruction"]:
            speak_cmd.extend(["--cosy-instruct", res["instruction"]])

        cur_child = subprocess.Popen(
            speak_cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            pass_fds=[lock_fd.fileno()]
        )
        speak_res = cur_child.wait(timeout=16)
        cur_child = None

        # STRICT validation: exit code 0 AND valid WAV header > 44 bytes
        if speak_res == 0 and temp_wav.is_file() and temp_wav.stat().st_size > 44:
            linear_vol = round(10.0 ** (res["gain_db"] / 20.0), 3)
            play_cmd = [
                "/usr/bin/afplay",
                "-r", str(res["speed"]),
                "-q", "1",
                "-v", str(linear_vol),
                str(temp_wav)
            ]
            cur_child = subprocess.Popen(
                play_cmd,
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                pass_fds=[lock_fd.fileno()]
            )
            cur_child.wait(timeout=14)
            cur_child = None
    except Exception:
        terminate_child()
    finally:
        terminate_child()
        if temp_wav.is_file():
            try:
                temp_wav.unlink()
            except OSError:
                pass
        try:
            lock_fd.close()
        except OSError:
            pass
    return 0


