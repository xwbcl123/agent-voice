def cmd_benchmark(voice_id: str | None = None, styles_str: str | None = None, runs: int = 1, text: str | None = None) -> int:
    """Run performance benchmark across styles measuring latency, audio duration, and RTF."""
    cfg = get_config()
    target_voice = voice_id or cfg.get("default_voice", "default")
    v_prof = get_voice_profile(target_voice)
    if not v_prof:
        print(f"❌ 错误: 未找到音色 profile '{target_voice}'")
        return 1

    sample_text = text or "系统自检完成，所有后台服务正常运行。"
    styles_to_test = [s.strip() for s in styles_str.split(",")] if styles_str else ["zero-shot", "neutral", "warm", "serious", "urgent"]

    print("=== Agent Voice Style Benchmark ===")
    print(f"Voice: {target_voice} | Runs per style: {runs}")
    print(f"Text: \"{sample_text}\"\n")
    print(f"{'STYLE':<14} {'WALL (ms)':<12} {'AUDIO (ms)':<12} {'RTF':<8} {'STATUS'}")
    print("-" * 55)

    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    temp_out = CACHE_DIR / f"bench-{os.getpid()}.wav"

    results = {}
    for st in styles_to_test:
        wall_times = []
        audio_durations = []
        rtfs = []
        ok = True

        for _ in range(runs):
            instruct = None
            if st != "zero-shot":
                sp = get_style_profile(st)
                if sp:
                    instruct = select_instruction_prompt(sp, sample_text)

            lang = "chinese" if re.search(r"[\u4e00-\u9fff]", sample_text) else "english"
            cmd = [
                str(SPEECH_BIN), "speak", sample_text,
                "--engine", "cosyvoice",
                "--cosyvoice-variant", COSY_VARIANT,
                "--voice-sample", str(v_prof["wav"]),
                "--cosy-reference-transcript", v_prof["transcript"],
                "--language", lang,
                "-o", str(temp_out)
            ]
            if instruct:
                cmd.extend(["--cosy-instruct", instruct])

            t0 = time.time()
            try:
                sub_res = subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=20)
                t1 = time.time()
                wall_ms = (t1 - t0) * 1000.0
                wall_times.append(wall_ms)

                if sub_res.returncode == 0 and temp_out.is_file():
                    with wave.open(str(temp_out), "rb") as w:
                        dur_ms = (w.getnframes() / float(w.getframerate())) * 1000.0
                        audio_durations.append(dur_ms)
                    rtf = wall_ms / dur_ms if dur_ms > 0 else 0
                    rtfs.append(rtf)
                else:
                    ok = False
            except Exception:
                ok = False

        if ok and wall_times:
            avg_wall = sum(wall_times) / len(wall_times)
            avg_audio = sum(audio_durations) / len(audio_durations)
            avg_rtf = sum(rtfs) / len(rtfs)
            results[st] = (avg_wall, avg_audio, avg_rtf)
            print(f"{st:<14} {int(avg_wall):<12} {int(avg_audio):<12} {avg_rtf:.2f}     OK")
        else:
            print(f"{st:<14} {'-':<12} {'-':<12} {'-':<8} FAIL")

    if temp_out.is_file():
        temp_out.unlink()

    if "zero-shot" in results and "neutral" in results:
        zs_wall = results["zero-shot"][0]
        neu_wall = results["neutral"][0]
        overhead = ((neu_wall - zs_wall) / zs_wall) * 100.0 if zs_wall > 0 else 0
        print(f"\nInstruct overhead (neutral vs zero-shot): {overhead:+.1f}% latency (target: <=15%).")

    return 0


